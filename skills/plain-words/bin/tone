#!/usr/bin/env bash
# Score files against the plain-words gate, from any directory. Plain mode is the default.
#   tone draft.md
#   tone --mode human /abs/path/to/post.md
set -euo pipefail

usage="usage: tone [--mode plain|human] <file> [...]"
args=()
if [ "${1:-}" = "--mode" ]; then
  [ $# -ge 2 ] || { echo "$usage" >&2; exit 64; }
  args+=("--mode" "$2")
  shift 2
fi

if [ $# -lt 1 ]; then
  echo "$usage" >&2
  exit 64
fi

skill_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

for f in "$@"; do
  [ -f "$f" ] || { echo "tone: no such file: $f" >&2; exit 66; }
done

for f in "$@"; do
  args+=("$(cd "$(dirname "$f")" && pwd)/$(basename "$f")")
done

cd "$skill_dir"
exec npx --yes tsx scripts/eval/score-file.ts "${args[@]}"
